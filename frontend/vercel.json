{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medilocker-34ij.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://medilocker-34ij.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
