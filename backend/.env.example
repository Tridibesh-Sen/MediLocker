# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,https://your-frontend.vercel.app

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_KEY_2=your_second_mistral_api_key_here

# Database
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-neon.ap-southeast-1.aws.neon.tech/medilocker?sslmode=require

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_service_role_key
# SUPABASE_BUCKET=medical-records

# Redis
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Security
JWT_SECRET=generate_random_hex_32_chars_for_jwt_session
JWT_EXPIRES_IN=2h
CRON_SECRET=generate_secret_for_midnight_12am_trigger_webhook
WEBAUTHN_RP_NAME=MediLocker
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5500
